{
  "version": 8,
  "name": "Indo Today Monochrome",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#191919"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0D2538",
        "fill-opacity": 1
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#9A9A9A",
        "line-opacity": 0.45,
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.35, 12, 0.8, 18, 1.2]
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#173A52",
        "line-opacity": 0.85,
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.3, 16, 1.0]
      }
    },
    {
      "id": "buildings",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 16,
      "paint": {
        "line-color": "#9A9A9A",
        "line-opacity": 0.5,
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.25, 18, 0.8]
      }
    },
    {
      "id": "minor-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["==", ["get", "class"], "minor"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#9A9A9A",
        "line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 11, 0.35, 14, 0.7, 18, 1.4]
      }
    },
    {
      "id": "tertiary-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13.5,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["==", ["get", "class"], "tertiary"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#9A9A9A",
        "line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 13.5, 0.5, 16, 1.0, 18, 1.6]
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary"], true, false]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#9A9A9A",
        "line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 5, 0.45, 10, 0.8, 14, 1.4, 18, 2.4]
      }
    },
    {
      "id": "country-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 1.5,
      "maxzoom": 6.5,
      "filter": [
        "all",
        ["==", ["get", "class"], "country"],
        ["<=", ["coalesce", ["get", "rank"], 99], 6]
      ],
      "layout": {
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99],
        "text-field": ["coalesce", ["get", "name:zh-Hans"], ["get", "name:zh"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 1.5, 11, 4, 14, 6.5, 17],
        "text-letter-spacing": 0.08,
        "text-max-width": 8,
        "text-padding": 18,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#D0D0D0",
        "text-opacity": 0.78,
        "text-halo-color": "#191919",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "province-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 4.5,
      "maxzoom": 9.5,
      "filter": [
        "all",
        ["match", ["get", "class"], ["state", "province"], true, false],
        ["<=", ["coalesce", ["get", "rank"], 99], 6]
      ],
      "layout": {
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99],
        "text-field": ["coalesce", ["get", "name:zh-Hans"], ["get", "name:zh"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4.5, 10.5, 7, 12.5, 9.5, 14],
        "text-letter-spacing": 0.06,
        "text-max-width": 8,
        "text-padding": 16,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#BDBDBD",
        "text-opacity": 0.7,
        "text-halo-color": "#191919",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "city-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 6.5,
      "maxzoom": 13.5,
      "filter": [
        "all",
        ["match", ["get", "class"], ["city", "town"], true, false],
        ["<=", ["coalesce", ["get", "rank"], 99], 10]
      ],
      "layout": {
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99],
        "icon-image": "indo-poi-place",
        "icon-size": 0.58,
        "icon-padding": 8,
        "text-field": ["coalesce", ["get", "name:zh-Hans"], ["get", "name:zh"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6.5, 10.5, 10, 12, 13.5, 13],
        "text-anchor": "left",
        "text-offset": [0.8, 0],
        "text-max-width": 8,
        "text-padding": 10,
        "text-allow-overlap": false
      },
      "paint": {
        "icon-color": "#BDBDBD",
        "icon-opacity": 0.72,
        "text-color": "#BDBDBD",
        "text-opacity": 0.72,
        "text-halo-color": "#191919",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "district-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 10.5,
      "maxzoom": 15.5,
      "filter": ["match", ["get", "class"], ["borough", "suburb"], true, false],
      "layout": {
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99],
        "text-field": ["coalesce", ["get", "name:zh-Hans"], ["get", "name:zh"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10.5, 9.5, 13, 11, 15.5, 12],
        "text-letter-spacing": 0.04,
        "text-max-width": 8,
        "text-padding": 14,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#A8A8A8",
        "text-opacity": 0.64,
        "text-halo-color": "#191919",
        "text-halo-width": 1.2,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "neighbourhood-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 13,
      "maxzoom": 17.5,
      "filter": ["match", ["get", "class"], ["quarter", "neighbourhood"], true, false],
      "layout": {
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99],
        "text-field": ["coalesce", ["get", "name:zh-Hans"], ["get", "name:zh"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 9, 15, 10, 17.5, 11],
        "text-letter-spacing": 0.03,
        "text-max-width": 8,
        "text-padding": 12,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#969696",
        "text-opacity": 0.56,
        "text-halo-color": "#191919",
        "text-halo-width": 1.1,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "airport-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "aerodrome_label",
      "minzoom": 8,
      "filter": ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
      "layout": {
        "icon-image": "indo-poi-airport",
        "icon-size": 0.7,
        "icon-padding": 8,
        "text-field": ["coalesce", ["get", "name:zh-Hans"], ["get", "name:zh"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10.5,
        "text-anchor": "left",
        "text-offset": [0.85, 0],
        "text-max-width": 8,
        "text-padding": 10,
        "text-allow-overlap": false
      },
      "paint": {
        "icon-color": "#BDBDBD",
        "icon-opacity": 0.72,
        "text-color": "#BDBDBD",
        "text-opacity": 0.72,
        "text-halo-color": "#191919",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "important-pois",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 11,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
        ["<=", ["coalesce", ["get", "rank"], 99], 8],
        [
          "any",
          ["match", ["get", "class"], ["town_hall", "park", "bus", "railway", "harbor", "hospital", "attraction", "stadium", "art_gallery", "castle", "library", "college", "school", "lodging", "place_of_worship"], true, false],
          ["match", ["get", "subclass"], ["place_of_worship", "museum", "art_gallery", "monument", "castle", "zoo", "theme_park", "university", "station"], true, false]
        ]
      ],
      "layout": {
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99],
        "icon-image": [
          "case",
          ["==", ["get", "class"], "hospital"], "indo-poi-hospital",
          ["==", ["get", "class"], "park"], "indo-poi-park",
          ["match", ["get", "class"], ["bus", "railway", "harbor"], true, false], "indo-poi-transit",
          ["match", ["get", "class"], ["school", "college", "library"], true, false], "indo-poi-education",
          ["match", ["get", "class"], ["town_hall", "stadium"], true, false], "indo-poi-civic",
          ["match", ["get", "subclass"], ["place_of_worship"], true, false], "indo-poi-worship",
          ["match", ["get", "subclass"], ["museum", "art_gallery", "monument", "castle"], true, false], "indo-poi-culture",
          "indo-poi-attraction"
        ],
        "icon-size": 0.76,
        "icon-padding": 5,
        "icon-allow-overlap": false,
        "text-field": ["coalesce", ["get", "name:zh-Hans"], ["get", "name:zh"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10.5,
        "text-letter-spacing": 0.03,
        "text-anchor": "top",
        "text-offset": [0, 0.85],
        "text-max-width": 8,
        "text-padding": 6,
        "text-allow-overlap": false,
        "text-optional": true
      },
      "paint": {
        "icon-color": "#BDBDBD",
        "icon-opacity": 0.82,
        "text-color": "#BDBDBD",
        "text-opacity": 0.82,
        "text-halo-color": "#191919",
        "text-halo-width": 1.2,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "everyday-pois",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 13.5,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
        ["<=", ["coalesce", ["get", "rank"], 99], 10],
        ["match", ["get", "class"], ["cafe", "fast_food", "grocery", "shop", "fuel", "post", "pharmacy", "restaurant"], true, false]
      ],
      "layout": {
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99],
        "icon-image": [
          "case",
          ["match", ["get", "class"], ["cafe", "fast_food", "restaurant"], true, false], "indo-poi-food",
          ["match", ["get", "class"], ["grocery", "shop", "pharmacy"], true, false], "indo-poi-shop",
          "indo-poi-civic"
        ],
        "icon-size": 0.66,
        "icon-padding": 7,
        "icon-allow-overlap": false,
        "text-field": ["coalesce", ["get", "name:zh-Hans"], ["get", "name:zh"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 9.5,
        "text-letter-spacing": 0.03,
        "text-anchor": "top",
        "text-offset": [0, 0.8],
        "text-max-width": 8,
        "text-padding": 7,
        "text-allow-overlap": false,
        "text-optional": true
      },
      "paint": {
        "icon-color": "#AFAFAF",
        "icon-opacity": 0.68,
        "text-color": "#AFAFAF",
        "text-opacity": 0.68,
        "text-halo-color": "#191919",
        "text-halo-width": 1.1,
        "text-halo-blur": 0.4
      }
    }
  ]
}
