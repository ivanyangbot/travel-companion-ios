# Copy this file to /etc/travel-companion-api/env, fill required values there,
# then set owner root:www-data and mode 0640. Do not commit the resulting file.
APP_ENV=production
DATABASE_URL=

# Add these only after provider credentials are available. Empty values leave
# the associated integration unavailable without exposing a provider key.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Agent v2 prefers the ARK Responses settings below. Reasoning stays enabled;
# this value only limits its depth. Supported: minimal, low, medium, high.
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-pro-260628
ARK_REASONING_EFFORT=low

# Apple Maps Server API token. Create it in Apple Developer under
# Certificates, Identifiers & Profiles > Maps > Tokens with Token Type
# "Server API". The token is long-lived; store it only on the server.
APPLE_MAPS_TOKEN=
